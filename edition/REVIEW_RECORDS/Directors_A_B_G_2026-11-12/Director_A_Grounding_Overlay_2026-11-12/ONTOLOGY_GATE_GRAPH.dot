digraph ResearchSearch {
  graph [rankdir=LR, bgcolor="white", pad=0.18, nodesep=0.32, ranksep=0.67, splines=spline, fontname="DejaVu Sans", fontsize=13, label="Total-ontology research: typed dependency gaps (NOT a physical model)", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f5", color="#656565", fontname="DejaVu Sans", fontsize=9, margin=0.11];
  edge [arrowsize=0.65, fontsize=7, fontname="DejaVu Sans"];
  PRE [label="Unselected prephysical primitives"];
  OPS [label="Operational preparations/effects"];
  MET [label="Transition-probability metric"];
  CP [label="Imported complex projective geometry"];
  ORI [label="Orientation\nphase\ncomplex structure"];
  PROB [label="Probability and instrument law"];
  COMP [label="Composites, tensor/locality"];
  GEN [label="Dynamics + calibrated time"];
  Q [label="Derived quantum mechanics"];
  CL [label="Classical Hamiltonian mechanics"];
  LIM [label="Controlled limit\ncoarse graining"];
  SPC [label="Spacetime\nclocks\ninertial structure"];
  EMP [label="Physical records, calibrated experiments"];
  TOTAL [label="TOTAL ONTOLOGY (unattained)" fillcolor="#fcecec" color="#af4343" penwidth=2];
  FNH [label="Finite homogeneous metric carrier"];
  FIN [label="Finite nonhomogeneous net"];
  H [label="Determinant holonomy identity"];
  PH [label="Unique signed Bargmann phase"];
  SPIN [label="Classical symplectic spin\nI3=0"];
  T [label="Stochastic dephasing channel"];
  PRE -> OPS [color="#a62b2b", label="OPEN PRIMITIVE TO OPERATION", tooltip="no warrant"];
  OPS -> MET [color="#a62b2b", label="OPEN PRIMITIVE TO OPERATION", tooltip="no operational metric"];
  MET -> CP [color="#a62b2b", label="OPEN PRIMITIVE TO OPERATION", tooltip="selection missing"];
  CP -> H [color="#177c67", label="DERIVED IN STIPULATED MODEL", tooltip="proved within imported CPn"];
  MET -> PH [color="#c16e19", label="OBSTRUCTED IN SCOPE", tooltip="conjugation and Gram continuum"];
  ORI -> PH [color="#3866ad", label="CONDITIONAL", tooltip="requires phase-sensitive orientation access"];
  PRE -> ORI [color="#a62b2b", label="OPEN PRIMITIVE TO OPERATION", tooltip="missing orientation selection"];
  OPS -> PROB [color="#a62b2b", label="OPEN PRIMITIVE TO OPERATION", tooltip="Born/instruments missing"];
  PROB -> Q [color="#a62b2b", label="OPEN PRIMITIVE TO OPERATION", tooltip="probability insufficient alone"];
  COMP -> Q [color="#a62b2b", label="OPEN PRIMITIVE TO OPERATION", tooltip="composition missing"];
  GEN -> Q [color="#a62b2b", label="OPEN PRIMITIVE TO OPERATION", tooltip="dynamical generator/clock missing"];
  PRE -> COMP [color="#a62b2b", label="OPEN PRIMITIVE TO OPERATION", tooltip="composition missing"];
  PRE -> GEN [color="#a62b2b", label="OPEN PRIMITIVE TO OPERATION", tooltip="time missing"];
  PRE -> SPC [color="#a62b2b", label="OPEN PRIMITIVE TO OPERATION", tooltip="causality/clock missing"];
  FNH -> CP [color="#c16e19", label="OBSTRUCTED IN SCOPE", tooltip="Gelander exact finite homogeneous GH"];
  FIN -> CP [color="#177c67", label="DERIVED IN STIPULATED MODEL", tooltip="imported geometry net converges"];
  SPIN -> Q [color="#c16e19", label="OBSTRUCTED IN SCOPE", tooltip="I3=0+symplectic is not unique QT"];
  Q -> LIM [color="#3866ad", label="CONDITIONAL", tooltip="requires regime/approximation"];
  LIM -> CL [color="#a62b2b", label="OPEN PRIMITIVE TO OPERATION", tooltip="Hamiltonian limit missing"];
  Q -> T [color="#177c67", label="DERIVED IN STIPULATED MODEL", tooltip="dephasing imported"];
  T -> CL [color="#c16e19", label="OBSTRUCTED IN SCOPE", tooltip="noninjective map != Hamiltonian flow"];
  SPC -> EMP [color="#9445aa", label="OPEN OPERATION TO PHYSICS", tooltip="clock/calibration missing"];
  Q -> EMP [color="#9445aa", label="OPEN OPERATION TO PHYSICS", tooltip="empirical correspondence missing"];
  CL -> EMP [color="#9445aa", label="OPEN OPERATION TO PHYSICS", tooltip="empirical correspondence missing"];
  EMP -> TOTAL [color="#9445aa", label="OPEN OPERATION TO PHYSICS", tooltip="experimental identification missing"];
  Q -> TOTAL [color="#a62b2b", label="OPEN PRIMITIVE TO OPERATION", tooltip="full derivation not achieved"];
  CL -> TOTAL [color="#a62b2b", label="OPEN PRIMITIVE TO OPERATION", tooltip="classical mechanics not derived"];
  subgraph cluster_legend {label="Edge legend: red = open primitive, purple = open empirical, orange = obstruction, green = proved only within imported math, blue = conditional"; color="#cccccc"; fontsize=9; style=dashed; }
}
